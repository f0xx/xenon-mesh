#!/sbin/openrc-run

name="xmeshd"
description="Distributed AI Context & Lab Orchestration Daemon"
command="/usr/local/bin/xmeshd"
command_user="xmeshd:xmeshd"

supervisor="supervise-daemon"
respawn_delay=3
respawn_max=0

output_log="/var/log/xmeshd/stdout.log"
error_log="/var/log/xmeshd/stderr.log"

# Provider keys. Mode 640, not in git. Exported into the daemon, not the yaml.
if [ -r /etc/xmeshd/provider.env ]; then
	set -a
	. /etc/xmeshd/provider.env
	set +a
fi

depend() {
    need net
    use postgresql mariadb
    after firewall wireguard
}

